# Spike only: <tenant>.m5.localhost:8105 -> shared Storage and Realtime. The tenant comes from the host, as in the
# platform's generic app route, and is passed to each service the way it expects it:
#   Storage:  X-Forwarded-Host = <tenant> (REQUEST_X_FORWARDED_HOST_REGEXP), set by Caddy (a client value is replaced)
#   Realtime: Host = <tenant>.realtime (Realtime takes the tenant from the first label of the host)
{
	admin off
	auto_https off
}

:8105 {
	@app header_regexp app Host ^([a-z][a-z0-9-]{1,30}[a-z0-9])\.m5\.localhost(:[0-9]+)?$
	handle @app {
		handle_path /storage/v1/* {
			reverse_proxy m5-storage:5000 {
				header_up X-Forwarded-Host {re.app.1}
			}
		}
		# public Realtime: websocket and the broadcast REST endpoint only (the tenant management API stays internal)
		handle /realtime/v1/api/broadcast {
			uri replace /realtime/v1/ /
			reverse_proxy m5-realtime:4000 {
				header_up Host {re.app.1}.realtime
			}
		}
		handle /realtime/v1/websocket {
			rewrite * /socket/websocket
			reverse_proxy m5-realtime:4000 {
				header_up Host {re.app.1}.realtime
			}
		}
		respond 404
	}
	respond 404
}
