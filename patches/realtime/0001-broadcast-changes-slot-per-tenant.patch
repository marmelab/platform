diff --git a/lib/realtime/tenants/replication_connection.ex b/lib/realtime/tenants/replication_connection.ex
index 8f56def..8365037 100644
--- a/lib/realtime/tenants/replication_connection.ex
+++ b/lib/realtime/tenants/replication_connection.ex
@@ -190,7 +190,7 @@ defmodule Realtime.Tenants.ReplicationConnection do
     Logger.metadata(external_id: tenant_id, project: tenant_id)
     Process.monitor(monitored_pid)
 
-    slot_name = replication_slot_name(@schema, @table)
+    slot_name = replication_slot_name(@schema, @table, tenant_id)
 
     {:ok, _watchdog_pid} =
       Realtime.Tenants.ReplicationConnection.Watchdog.start_link(
@@ -216,7 +216,7 @@ defmodule Realtime.Tenants.ReplicationConnection do
     # But ReplicationConnection does not interact with DbConnection so we don't
     # want to trap exits
     Process.flag(:trap_exit, false)
-    replication_slot_name = replication_slot_name(@schema, @table)
+    replication_slot_name = replication_slot_name(@schema, @table, state.tenant_id)
     Logger.info("Checking if replication slot #{replication_slot_name} exists")
 
     query = "SELECT * FROM pg_replication_slots WHERE slot_name = '#{replication_slot_name}'"
@@ -537,12 +537,27 @@ defmodule Realtime.Tenants.ReplicationConnection do
     end
   end
 
-  def replication_slot_name(schema, table) do
-    "supabase_#{schema}_#{table}_replication_slot_#{slot_suffix()}"
+  @doc """
+  Name of the replication slot of a tenant's Broadcast Changes. Replication slots are cluster-wide: with
+  `SLOT_NAME_PER_TENANT=true`, the name ends with 16 hex characters of the SHA-256 of the tenant id, so that tenants
+  whose databases share a cluster get a slot each (at most 63 bytes without `SLOT_NAME_SUFFIX`).
+  """
+  def replication_slot_name(schema, table, tenant_id \\ nil) do
+    "supabase_#{schema}_#{table}_replication_slot_#{slot_suffix()}#{tenant_slot_suffix(tenant_id)}"
   end
 
   defp slot_suffix, do: Application.get_env(:realtime, :slot_name_suffix)
 
+  defp tenant_slot_suffix(tenant_id) when is_binary(tenant_id) do
+    if Application.get_env(:realtime, :slot_name_per_tenant, false) do
+      :sha256 |> :crypto.hash(tenant_id) |> Base.encode16(case: :lower) |> binary_part(0, 16)
+    else
+      ""
+    end
+  end
+
+  defp tenant_slot_suffix(_tenant_id), do: ""
+
   defp tuple_to_map(tuple_data, columns) do
     tuple_data
     |> Tuple.to_list()
