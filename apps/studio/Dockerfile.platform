# Runtime image for the Next.js standalone output built on the host by build.sh (context: .image/).
FROM node:22-slim
WORKDIR /app
COPY . .
# The standalone output was traced on the build host: install sharp's native binaries for the image platform.
ARG SHARP_VERSION
RUN set -eu; \
    npm install --no-save --no-package-lock --no-audit --no-fund --prefix /tmp/sharp "sharp@${SHARP_VERSION}"; \
    rm -rf node_modules/.pnpm/node_modules/@img node_modules/.pnpm/@img+sharp-darwin* node_modules/.pnpm/@img+sharp-libvips-darwin*; \
    mkdir -p node_modules && cp -R /tmp/sharp/node_modules/@img node_modules/@img; \
    rm -rf /tmp/sharp /root/.npm
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 HOSTNAME=0.0.0.0 PORT=3000
USER node
EXPOSE 3000
CMD ["node", "apps/studio/server.js"]
