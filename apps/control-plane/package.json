{
  "name": "@platform/control-plane",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node src/index.ts",
    "typecheck": "tsc --noEmit",
    "e2e": "node --test --test-concurrency=1 test/e2e.test.ts test/ci.e2e.test.ts test/deploy-cli.e2e.test.ts test/plugin.e2e.test.ts test/admin.e2e.test.ts test/metrics.e2e.test.ts test/storage-realtime.e2e.test.ts test/pooler.e2e.test.ts test/auth-email.e2e.test.ts test/sso.e2e.test.ts",
    "e2e:sso": "node --test --test-concurrency=1 test/sso.e2e.test.ts",
    "e2e:auth-email": "node --test --test-concurrency=1 test/auth-email.e2e.test.ts",
    "e2e:storage-realtime": "node --test --test-concurrency=1 test/storage-realtime.e2e.test.ts",
    "e2e:pooler": "node --test --test-concurrency=1 test/pooler.e2e.test.ts",
    "e2e:deploy-cli": "node --test --test-concurrency=1 test/deploy-cli.e2e.test.ts",
    "e2e:plugin": "node --test --test-concurrency=1 test/plugin.e2e.test.ts",
    "test": "node --test test/studio-policy.test.ts test/login-limit.test.ts test/access-log.test.ts test/auth-policy.test.ts test/sso-policy.test.ts && ../../plugin/test/scripts.test.sh",
    "e2e:studio": "node --test --test-concurrency=1 test/studio.e2e.test.ts",
    "e2e:admin": "node --test --test-concurrency=1 test/admin.e2e.test.ts test/metrics.e2e.test.ts ../admin/test/admin-ui.e2e.test.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@platform/shared": "workspace:*",
    "@platform/sql": "workspace:*",
    "dockerode": "^5.0.1",
    "hono": "^4.13.12",
    "jose": "^6.2.12",
    "nodemailer": "^7.0.11",
    "pg": "^8.23.1",
    "smol-toml": "^1.9.0",
    "tar": "^7.5.22",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "@types/dockerode": "^4.0.1",
    "@types/node": "^26.6.3",
    "@types/nodemailer": "^7.0.4",
    "@types/pg": "^8.23.1",
    "typescript": "^7.0.2"
  }
}
